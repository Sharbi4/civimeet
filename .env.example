# SERVER SECRETS ONLY. Never use VITE_ prefixes or commit actual credentials.
PERPLEXITY_API_KEY=
# Generate a separate random token (at least 32 characters) for the private preview.
# This is not the Perplexity key. Operators enter this token at /agent.
CIVIMEET_RESEARCH_TOKEN=

# Public Supabase project configuration (not a service-role/secret key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only database configuration for authenticated steward research.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only managed Chromium. No Browserbase credentials are required.
STEEL_API_KEY=
# Keep false until the private-login, provider-log and stale-viewer revocation checks pass.
STEEL_HUMAN_HANDOFF_ENABLED=false

# SERVER SECRETS ONLY. Never use VITE_ prefixes or commit actual credentials.
PERPLEXITY_API_KEY=
# Generate a separate random token (at least 32 characters) for the private preview.
# This is not the Perplexity key. Operators enter this token at /agent.
CIVIMEET_RESEARCH_TOKEN=

# Public Supabase project configuration (not a service-role/secret key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only database configuration for authenticated steward research.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only managed Chromium. No Browserbase credentials are required.
STEEL_API_KEY=
# Keep false until the private-login, provider-log and stale-viewer revocation checks pass.
STEEL_HUMAN_HANDOFF_ENABLED=false

# Managed organizer: direct OpenAI Agents API, separate from the analytics gateway.
OPENAI_ORGANIZER_ENABLED=false
OPENAI_API_KEY=
OPENAI_PROJECT_ID=proj_YcAMhVhK4eAC6sEeJq2b5j0d
# Choose a model supported by your OpenAI project's Agents API.
OPENAI_ORGANIZER_MODEL=gpt-6-sol
OPENAI_ORGANIZER_TIMEOUT_MS=120000
# Provider-enforced best-effort per-session spend cap, USD cents.
OPENAI_ORGANIZER_SESSION_CENTS=200
OPENAI_ORGANIZER_PROVIDER_SPEND_CAP=false
OPENAI_ORGANIZER_SESSION_TOKEN_LIMIT=100000
